# PrintStation Monorepo Root .gitignore
# Rule 10: Strict exclusion of databases, secrets, build artifacts, and customer uploads

# Dependencies
node_modules/
.pnp/
.pnp.js

# Production and build outputs
.next/
dist/
dist-ssr/
out/
build/
.vite/
.vercel/
*.tsbuildinfo

# Environment variables & secrets (Rule 8 & 9)
.env
.env.local
.env.*.local
*.pem
*.key

# SQLite databases & persistent caches (Rule 5 & 10)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
printstation.db
data/

# User documents & temporary files (Rule 7 & 10)
uploads/
downloads/
storage/
tmp/
.tmp/
scratch/
*.tmp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
